        $('#EmployeeId').select2({
            theme: 'bootstrap-5',
            placeholder: '-- Search Employee --',
            allowClear: true,
            dropdownParent: $('#attendanceModal'),
            minimumInputLength: 2,
            width: '100%',
            ajax: {
                url: '@Url.Action("Search", "Employee")',
                type: 'GET',
                dataType: 'json',
                delay: 300,
                data: function (params) {
                    return {
                        search: params.term || ''
                    };
                },
                processResults: function (response) {
                    return {
                        results: response.map(function (item) {
                            return {
                                id: item.id,
                                text: item.text,
                                department: item.info
                            };
                        })
                    };
                },

                cache: true
            },

            templateResult: function (item) {
                // Loading / placeholder item
                if (item.loading) {
                    return item.text;
                }

                // Empty item
                if (!item.id) {
                    return item.text;
                }

                return $(`
                    <div class="py-1">
                        <div class="fw-semibold">
                            ${item.text}
                        </div>

                        ${item.department
                            ? `<small class="text-muted">${item.department}</small>`
                            : ''}
                    </div>
                `);
            },

            templateSelection: function (item) {
                return item.text || item.id;
            },

            escapeMarkup: function (markup) {
                return markup;
            }
        }); 

