    <!-- Filter -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white fw-bold">
            <i class="bi bi-funnel"></i>
            Search Filter
        </div>
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-3">
                    <label class="form-label">Employee</label>
                    <select class="form-select">
                        <option>All Employee</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Department</label>
                    <select class="form-select" id="DepartmentSelect">
    <option value="">All Department</option>
</select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Status</label>
                    <select class="form-select" id="StatusSelect">
    <option value="">All Status</option>
</select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">From</label>
                    <input type="date" class="form-control" id="FromDate">
                </div>

                <div class="col-md-2">
                    <label class="form-label">To</label>
                    <input type="date" class="form-control" id="ToDate">
                </div>

                <div class="col-md-1 d-grid">
                    <label>&nbsp;</label>
                    <button class="btn btn-primary">
                        <i class="bi bi-search"></i>
                    </button>
                </div>

            </div>

        </div>
    </div>

    <!-- Attendance Table -->
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm full-height-card">
                <div class="card-header py-2 px-3 bg-light">
                    <div class="d-flex align-items-center">
                        <div>
                            <h6 class="mb-0 fw-bold">
                                @Model.Title
                            </h6>
                            <small class="text-muted">
                                Daily Employee Attendance
                            </small>
                        </div>
                         
                        <div class="ms-auto d-flex gap-2">
                            <button id="add-new" class="btn btn-sm btn-primary">
                                <i class="fa-solid fa-plus me-1"></i> Add New
                            </button>
                            <button id="csv-export" class="btn btn-sm btn-outline-success">
                                <i class="fa-solid fa-file-excel me-1"></i> Export CSV
                            </button>
                            <button id="pdf-export" class="btn btn-sm btn-outline-danger">
                                <i class="fa-solid fa-file-pdf me-1"></i> Export PDF
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-2">
                    <div class="table-responsive">
                        <table id="main-table" class="table table-hover align-middle mb-0">
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Attendance Modal -->
<div class="modal fade"
     id="attendanceModal"
     tabindex="-1"
     aria-labelledby="attendanceModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="attendanceModalLabel">
                    <i class="bi bi-calendar-check text-primary me-2"></i>
                    <span id="modalTitle">New Attendance</span>
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <form id="attendanceForm"
                  asp-action="Add"
                  asp-controller="Attendance"
                  method="post"
                  enctype="multipart/form-data"
                  autocomplete="off">
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Mode)
                @Html.HiddenFor(m => m.Title)
                <input type="hidden" asp-for="Item.AttendanceId" id="Item_AttendanceId" asp-key="true" />
                <input type="hidden" asp-for="Item.LateMinutes" id="Item_LateMinutes" value="0" />
                <input type="hidden" asp-for="Item.EarlyOutMinutes" id="Item_EarlyOutMinutes" value="0" />
                <input type="hidden" asp-for="Item.WorkMinutes" id="Item_WorkMinutes" value="0" />
                <input type="hidden" asp-for="Item.OvertimeMinutes" id="Item_OvertimeMinutes" value="0" />
                <input type="hidden" asp-for="Item.IsManualEntry" id="Item_IsManualEntry" value="true" />

                <div class="modal-body p-4">
                    <div class="row g-3">
                        <!-- Employee -->
                        <div class="col-md-6">
                            <label asp-for="Item.EmployeeId" class="form-label fw-semibold">
                                Employee <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Item.EmployeeId"
                                    id="Item_EmployeeId"
                                    class="form-select"
                                    required>
                                <option value="">-- Search & Select Employee --</option>
                            </select>
                            <span asp-validation-for="Item.EmployeeId" class="text-danger small"></span>
                        </div>

                        <!-- Attendance Date -->
                        <div class="col-md-3">
                            <label asp-for="Item.AttendanceDate" class="form-label fw-semibold">
                                Attendance Date <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Item.AttendanceDate"
                                   id="Item_AttendanceDate"
                                   type="date"
                                   class="form-control"
                                   required />
                            <span asp-validation-for="Item.AttendanceDate" class="text-danger small"></span>
                        </div>

                        <!-- Attendance Status -->
                        <div class="col-md-3">
                            <label asp-for="Item.AttendanceStatus" class="form-label fw-semibold">
                                Status <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Item.AttendanceStatus"
                                    id="Item_AttendanceStatus"
                                    class="form-select"
                                    required>
                                <option value="PRESENT">Present</option>
                                <option value="LATE">Late</option>
                                <option value="ABSENT">Absent</option>
                                <option value="LEAVE">Leave</option>
                                <option value="HOLIDAY">Holiday</option>
                                <option value="RESTDAY">Rest Day</option>
                            </select>
                            <span asp-validation-for="Item.AttendanceStatus" class="text-danger small"></span>
                        </div>

                        <!-- Shift -->
                        <div class="col-md-7">
                            <label asp-for="Item.ShiftId" class="form-label fw-semibold">
                                Shift
                            </label>
                            <select asp-for="Item.ShiftId"
                                    id="Item_ShiftId"
                                    class="form-select">
                                <option value="">-- Select Shift --</option>
                            </select>
                            <span asp-validation-for="Item.ShiftId" class="text-danger small"></span>
                        </div>

                        <!-- Day Type Flags -->
                        <div class="col-md-5">
                            <label class="form-label fw-semibold d-block">Day Type</label>
                            <div class="d-flex gap-4 pt-1">
                                <div class="form-check form-switch">
                                    <input asp-for="Item.IsHoliday"
                                           id="Item_IsHoliday"
                                           class="form-check-input"
                                           type="checkbox"
                                           role="switch" />
                                    <label asp-for="Item.IsHoliday" class="form-check-label fw-semibold" style="cursor: pointer;">
                                        Holiday
                                    </label>
                                </div>
                                <div class="form-check form-switch">
                                    <input asp-for="Item.IsWeekend"
                                           id="Item_IsWeekend"
                                           class="form-check-input"
                                           type="checkbox"
                                           role="switch" />
                                    <label asp-for="Item.IsWeekend" class="form-check-label fw-semibold" style="cursor: pointer;">
                                        Weekend
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Timing Comparison Section -->
                        <div class="col-md-6">
                            <div class="card border bg-light shadow-none h-100">
                                <div class="card-body p-3">
                                    <h6 class="fw-bold mb-3 text-secondary">
                                        <i class="bi bi-clock me-1"></i> Scheduled Shift Time
                                    </h6>
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <label asp-for="Item.ScheduledTimeIn" class="form-label small fw-semibold">Time In</label>
                                            <input asp-for="Item.ScheduledTimeIn"
                                                   id="Item_ScheduledTimeIn"
                                                   type="time"
                                                   class="form-control" />
                                        </div>
                                        <div class="col-6">
                                            <label asp-for="Item.ScheduledTimeOut" class="form-label small fw-semibold">Time Out</label>
                                            <input asp-for="Item.ScheduledTimeOut"
                                                   id="Item_ScheduledTimeOut"
                                                   type="time"
                                                   class="form-control" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card border border-primary-subtle bg-light-subtle shadow-none h-100">
                                <div class="card-body p-3">
                                    <h6 class="fw-bold mb-3 text-primary">
                                        <i class="bi bi-fingerprint me-1"></i> Actual Attendance Time
                                    </h6>
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <label asp-for="Item.ActualTimeIn" class="form-label small fw-semibold">Actual In</label>
                                            <input asp-for="Item.ActualTimeIn"
                                                   id="Item_ActualTimeIn"
                                                   type="time"
                                                   class="form-control" />
                                        </div>
                                        <div class="col-6">
                                            <label asp-for="Item.ActualTimeOut" class="form-label small fw-semibold">Actual Out</label>
                                            <input asp-for="Item.ActualTimeOut"
                                                   id="Item_ActualTimeOut"
                                                   type="time"
                                                   class="form-control" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Calculation Preview Summary -->
                        <div class="col-12">
                            <div class="bg-light rounded p-3 border">
                                <div class="row text-center g-2">
                                    <div class="col-3 border-end">
                                        <small class="text-muted d-block fw-semibold">Late</small>
                                        <span id="previewLate" class="fw-bold fs-6 text-danger">0 min</span>
                                    </div>
                                    <div class="col-3 border-end">
                                        <small class="text-muted d-block fw-semibold">Early Out</small>
                                        <span id="previewEarly" class="fw-bold fs-6 text-warning">0 min</span>
                                    </div>
                                    <div class="col-3 border-end">
                                        <small class="text-muted d-block fw-semibold">Working Hours</small>
                                        <span id="previewWork" class="fw-bold fs-6 text-success">0h 0m</span>
                                    </div>
                                    <div class="col-3">
                                        <small class="text-muted d-block fw-semibold">Overtime</small>
                                        <span id="previewOvertime" class="fw-bold fs-6 text-info">0h 0m</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Remarks -->
                        <div class="col-12">
                            <label asp-for="Item.Remarks" class="form-label fw-semibold">
                                Remarks
                            </label>
                            <textarea asp-for="Item.Remarks"
                                      id="Item_Remarks"
                                      class="form-control"
                                      rows="2"
                                      maxlength="500"
                                      placeholder="Enter attendance remarks or adjustments..."></textarea>
                            <div class="text-end">
                                <small class="text-muted">Maximum 500 characters</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            onclick="resetAttendanceForm()">
                        <i class="fa-solid fa-rotate-left me-1"></i>
                        Reset
                    </button>
                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i>
                        Cancel
                    </button>
                    <button type="button"
                            id="save-button"
                            class="btn btn-primary"
                            onclick="saveAttendance()">
                        <i class="bi bi-check-circle me-1"></i>
                        Save Attendance
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function closeModal() {
            const modalElement = document.getElementById('attendanceModal');
            const modal = bootstrap.Modal.getInstance(modalElement);
            setReadonly(false);
            if (modal) {
                modal.hide();
            }
        }
        function showModal(isEdit) {
            $('#modalTitle').text(
                isEdit ? 'Edit Attendance' : 'Add Attendance'
            );

            setReadonly(isEdit);

            resetAttendanceForm();

            // Default date = today
            const today = new Date();

            const yyyy = today.getFullYear();
            const mm = String(today.getMonth() + 1).padStart(2, '0');
            const dd = String(today.getDate()).padStart(2, '0');

            $('#AttendanceDate').val(`${yyyy}-${mm}-${dd}`);

            loadShifts();

            const modal = new bootstrap.Modal(
                document.getElementById('attendanceModal')
            );
            modal.show();
        }
        $(document).ready(function () {
             $('#logoFile').on('change', function () {
                 const file = this.files[0];
                 const preview = document.getElementById('logoPreview');
                 if (!file) {
                     preview.style.display = 'none';
                     return;
                 }
                 preview.src = URL.createObjectURL(file);
                 preview.style.display = 'block';
            });
            
            const table = $('#main-table').DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                autoWidth: false,
                filter: true,
                orderMulti: false,
                order: [[1, "desc"]],
                ajax: {
                    url: '@Url.Action("GetList", "Attendance")',
                    type: "POST",
                    contentType: "application/json",
                    data: function (d) {
                        const employeeId = $('#Item_EmployeeId').val();
                        const departmentId = $('#DepartmentSelect').val();
                        const status = $('#StatusSelect').val();
                        const fromDate = $('#FromDate').val();
                        const toDate = $('#ToDate').val();
                        const filters = {
                            employeeId: employeeId,
                            departmentId: departmentId,
                            status: status,
                            fromDate: fromDate,
                            toDate: toDate
                        };
                        return JSON.stringify(Object.assign(d, filters));
                    },
                    dataSrc: function (json) {
                        return json.data || [];
                    },
                    error: function (xhr) {
                        if (xhr.status === 401 || xhr.status === 403)
                            return;
                        notify.error("Failed to load attendance.");
                    }
                },
                columnDefs: [
                    {
                        targets: -1,
                        className: "not-export"
                    }
                ],
                columns: [
                    // Employee
                    {
                        //data: "employeeCode",
                        data : null,
                        title: "Employee",
                        width: "260px",
                        orderable: false,
                        render: function (data) {
                            return `
                                <div class="fw-bold">
                                    ${data.employeeCode}
                                </div>
                                <div>
                                    ${data.employeeName}
                                </div>
                                <small class="text-muted">
                                    ${data.DepartmentDescription ?? ""}
                                </small>
                            `;
                        }
                    },
                    // Attendance Date
                    {
                        data: "attendanceDate",
                        title: "Date",
                        width: "110px",
                        className: "text-center",
                        render: function (data) {
                            if (!data)
                                return "-";
                            return moment(data).format("DD MMM YYYY");
                        }
                    },
                    // Shift
                    {
                        data: "shiftCode",
                        title: "Shift",
                        width: "100px",
                        className: "text-center",
                        render: function (data) {
                            return `
                                <span class="badge bg-primary">
                                    ${data ?? "-"}
                                </span>
                            `;
                        }
                    },
                    // Schedule
                    {
                        data: null,
                        title: "Schedule",
                        width: "120px",
                         orderable: false,
                        className: "text-center",
                        render: function (data) {
                            return `
                                <div class="fw-semibold">
                                    ${data.scheduledTimeIn ?? "--:--"}
                                </div>

                                <small class="text-muted">
                                    ${data.scheduledTimeOut ?? "--:--"}
                                </small>
                            `;
                        }
                    },
                    // Actual
                    {
                        data: null,
                        title: "Actual",
                        width: "120px",
                         orderable: false,
                        className: "text-center",
                        render: function (data) {
                            return `
                                <div class="text-success fw-semibold">
                                    ${data.actualTimeIn ?? "-"}
                                </div>

                                <small class="text-danger">
                                    ${data.actualTimeOut ?? "-"}
                                </small>
                            `;
                        }
                    },
                    // Late / Early
                    {
                        data: null,
                        title: "Late/Early",
                        width: "120px",
                         orderable: false,
                        className: "text-center",
                        render: function (data) {
                            return `
                                <div>
                                    <span class="badge bg-danger">
                                        Late ${data.lateMinutes}m
                                    </span>
                                </div>
                                <div class="mt-1">
                                    <span class="badge bg-warning text-dark">
                                        Early ${data.earlyOutMinutes}m
                                    </span>
                                </div>
                            `;
                        }
                    },

                    // Working Hours
                    {
                        data: "workMinutes",
                        title: "Work",
                        width: "90px",
                        className: "text-center",
                        render: function (data) {
                            let h = Math.floor((data || 0) / 60);
                            let m = (data || 0) % 60;
                            return `
                                <span class="fw-bold">
                                    ${h}h ${m}m
                                </span>
                            `;
                        }
                    },

                    // OT
                    {
                        data: "overtimeMinutes",
                        title: "OT",
                        width: "90px",
                        className: "text-center",
                        render: function (data) {
                            if (!data)
                                return "-";

                            let h = Math.floor(data / 60);
                            let m = data % 60;
                            return `
                                <span class="badge bg-info">
                                    ${h}h ${m}m
                                </span>
                            `;
                        }
                    },
                    // Status
                    {
                        data: "attendanceStatus",
                        title: "Status",
                        width: "120px",
                        className: "text-center",
                        render: function (data) {
                            switch ((data || "").toUpperCase()) {
                                case "PRESENT":
                                    return `
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i>
                                            Present
                                        </span>`;
                                case "LATE":
                                    return `
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-clock"></i>
                                            Late
                                        </span>`;
                                case "ABSENT":
                                    return `
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle"></i>
                                            Absent
                                        </span>`;
                                case "LEAVE":
                                    return `
                                        <span class="badge bg-info">
                                            <i class="bi bi-airplane"></i>
                                            Leave
                                        </span>`;
                                case "HOLIDAY":
                                    return `
                                        <span class="badge bg-primary">
                                            <i class="bi bi-calendar-event"></i>
                                            Holiday
                                        </span>`;
                                case "RESTDAY":
                                    return `
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-moon"></i>
                                            Rest Day
                                        </span>`;
                                default:
                                    return `
                                        <span class="badge bg-dark">
                                            ${data}
                                        </span>`;
                            }
                        }
                    },

                    // Action
                    {
                        data: null,
                        title: "Action",
                        width: "90px",
                        className: "text-center",
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            return `
                                <div class="d-flex justify-content-center gap-2">
                                    <a href="javascript:void(0)"
                                       onclick="viewAttendance(${row.attendanceId})"
                                       title="View">
                                        <i class="fa-solid fa-eye text-primary"></i>
                                    </a>
                                    <a href="javascript:void(0)"
                                       onclick="editAttendance(${row.attendanceId})"
                                       title="Adjust">
                                        <i class="fa-solid fa-pen-to-square text-success"></i>
                                    </a>
                                    <a href="javascript:void(0)"
                                       onclick="confirmDelete(() => deleteAttendance(${row.attendanceId}))"
                                       title="Delete">
                                        <i class="fa-solid fa-trash text-danger"></i>
                                    </a>
                                </div>
                            `;
                        }
                    }
                ],
                dom:
                    "B<'row mb-3'<'col-md-6'l><'col-md-6 text-end'f>>" +
                    "rt" +
                    "<'row mt-3'<'col-md-6'i><'col-md-6'p>>",
                buttons: [
                    {
                        extend: "csvHtml5",
                        className: "btn-export-csv d-none",
                        title: "@Model.Title",
                        exportOptions: {
                            columns: ":not(.not-export)"
                        }
                    },
                    {
                        extend: "pdfHtml5",
                        className: "btn-export-pdf d-none",
                        title: "@Model.Title",
                        exportOptions: {
                            columns: ":not(.not-export)"
                        }
                    }
                ]
            });
            
            $('#csv-export').on('click', function () {
                $('.btn-export-csv').trigger('click');
            });

            $('#pdf-export').on('click', function () {
                $('.btn-export-pdf').trigger('click');
            });

            $('#add-new').on('click', function () {
                showModal(false);
            });

            $('#save-button').on('click', function () {
                saveAttendance();
            });

            // Recalculate on any time input changes
            $('#Item_ScheduledTimeIn, #Item_ScheduledTimeOut, #Item_ActualTimeIn, #Item_ActualTimeOut')
                .on('change input', function () {
                    calculateAttendance();
                });

            // Shift dropdown selection change
            $('#Item_ShiftId').on('change', function () {
                const shiftId = $(this).val();
                if (!shiftId) {
                    $('#Item_ScheduledTimeIn').val('');
                    $('#Item_ScheduledTimeOut').val('');
                    calculateAttendance();
                    return;
                }

                $.ajax({
                    type: 'GET',
                    url: '@Url.Action("GetData", "Shift")',
                    data: { id: shiftId },
                    success: function (data) {
                        if (!data) return;
                        $('#Item_ScheduledTimeIn').val(data.startTime ? data.startTime.substring(0, 5) : '');
                        $('#Item_ScheduledTimeOut').val(data.endTime ? data.endTime.substring(0, 5) : '');
                        calculateAttendance();
                    },
                    error: function (xhr) {
                        if (xhr.status === 401 || xhr.status === 403) return;
                        notify.error('Failed to retrieve shift schedule details.');
                    }
                });
            });

            // Employee Select2 search initialization
            $('#Item_EmployeeId').select2({
                theme: 'bootstrap-5',
                placeholder: '-- Search & Select Employee --',
                allowClear: true,
                dropdownParent: $('#attendanceModal'),
                minimumInputLength: 1,
                width: '100%',
                ajax: {
                    url: '@Url.Action("Search", "Employee")',
                    type: 'GET',
                    dataType: 'json',
                    delay: 300,
                    data: function (params) {
                        return {
                            searchTerm: params.term || ''
                        };
                    },
                    processResults: function (response) {
                        return {
                            results: (response || []).map(function (item) {
                                return {
                                    id: item.id,
                                    text: item.text,
                                    department: item.info
                                };
                            })
                        };
                    },
                    cache: true
                },
                templateResult: function (item) {
                    if (item.loading || !item.id) return item.text;
                    return $(`
                        <div class="py-1">
                            <div class="fw-semibold">${item.text}</div>
                            ${item.department ? `<small class="text-muted">${item.department}</small>` : ''}
                        </div>
                    `);
                },
                templateSelection: function (item) {
                    return item.text || item.id;
                },
                escapeMarkup: function (markup) {
                    return markup;
                }
            });
        });

        // ------------------------------------------------------------
        // Time Conversion and Calculation Helpers
        // ------------------------------------------------------------
        function timeToMinutes(value) {
            if (!value) return null;
            const parts = value.split(':');
            if (parts.length < 2) return null;

            const hour = parseInt(parts[0], 10);
            const minute = parseInt(parts[1], 10);
            if (isNaN(hour) || isNaN(minute)) return null;

            return (hour * 60) + minute;
        }

        function formatMinutes(minutes) {
            minutes = parseInt(minutes || 0, 10);
            const hours = Math.floor(minutes / 60);
            const mins = minutes % 60;
            return `${hours}h ${mins}m`;
        }

        function calculateAttendance() {
            const scheduledIn = timeToMinutes($('#Item_ScheduledTimeIn').val());
            const scheduledOut = timeToMinutes($('#Item_ScheduledTimeOut').val());
            const actualIn = timeToMinutes($('#Item_ActualTimeIn').val());
            const actualOut = timeToMinutes($('#Item_ActualTimeOut').val());

            let lateMinutes = 0;
            let earlyOutMinutes = 0;
            let workMinutes = 0;
            let overtimeMinutes = 0;

            // Late calculation
            if (scheduledIn !== null && actualIn !== null && actualIn > scheduledIn) {
                lateMinutes = actualIn - scheduledIn;
            }

            // Early Out calculation
            if (scheduledOut !== null && actualOut !== null && actualOut < scheduledOut) {
                earlyOutMinutes = scheduledOut - actualOut;
            }

            // Working hours calculation
            if (actualIn !== null && actualOut !== null) {
                let out = actualOut;
                if (out < actualIn) { // Support overnight shifts
                    out += 24 * 60;
                }
                workMinutes = Math.max(0, out - actualIn);
            }

            // Overtime calculation
            if (scheduledOut !== null && actualOut !== null) {
                let out = actualOut;
                if (out < actualIn) {
                    out += 24 * 60;
                }
                let scheduled = scheduledOut;
                if (scheduled < scheduledIn) {
                    scheduled += 24 * 60;
                }
                overtimeMinutes = Math.max(0, out - scheduled);
            }

            // Update hidden inputs
            $('#Item_LateMinutes').val(lateMinutes);
            $('#Item_EarlyOutMinutes').val(earlyOutMinutes);
            $('#Item_WorkMinutes').val(workMinutes);
            $('#Item_OvertimeMinutes').val(overtimeMinutes);

            // Update preview labels
            $('#previewLate').text(`${lateMinutes} min`);
            $('#previewEarly').text(`${earlyOutMinutes} min`);
            $('#previewWork').text(formatMinutes(workMinutes));
            $('#previewOvertime').text(formatMinutes(overtimeMinutes));

            // Auto-suggest status if currently default
            const currentStatus = $('#Item_AttendanceStatus').val();
            if (currentStatus === 'PRESENT' && lateMinutes > 0) {
                $('#Item_AttendanceStatus').val('LATE');
            } else if (currentStatus === 'LATE' && lateMinutes === 0) {
                $('#Item_AttendanceStatus').val('PRESENT');
            }
        }

        // ------------------------------------------------------------
        // Load Shift Dropdown
        // ------------------------------------------------------------
        function loadShifts(selectedShiftId) {
            $.ajax({
                type: 'GET',
                url: '@Url.Action("GetShifts", "Shift")',
                success: function (data) {
                    const select = $('#Item_ShiftId');
                    select.empty();
                    select.append('<option value="">-- Select Shift --</option>');

                    if (!data) return;

                    data.forEach(function (item) {
                        const opt = $('<option>', {
                            value: item.id,
                            text: (item.shiftCode ? item.shiftCode + ' - ' : '') + item.shiftName
                        });
                        if (selectedShiftId && item.id == selectedShiftId) {
                            opt.prop('selected', true);
                        }
                        select.append(opt);
                    });
                },
                error: function (xhr) {
                    if (xhr.status === 401 || xhr.status === 403) return;
                    notify.error('Failed to load shift list.');
                }
            });
        }

        // ------------------------------------------------------------
        // Reset Form
        // ------------------------------------------------------------
        function resetAttendanceForm() {
            const form = $('#attendanceForm')[0];
            if (form) {
                form.reset();
                $(form).removeClass('was-validated');
            }

            const today = new Date();
            const yyyy = today.getFullYear();
            const mm = String(today.getMonth() + 1).padStart(2, '0');
            const dd = String(today.getDate()).padStart(2, '0');

            $('#Item_AttendanceId').val('0');
            $('#Item_AttendanceDate').val(`${yyyy}-${mm}-${dd}`);
            $('#Item_AttendanceStatus').val('PRESENT');
            $('#Item_EmployeeId').val('').trigger('change');
            $('#Item_ShiftId').val('');
            $('#Item_ScheduledTimeIn').val('');
            $('#Item_ScheduledTimeOut').val('');
            $('#Item_ActualTimeIn').val('');
            $('#Item_ActualTimeOut').val('');
            $('#Item_IsHoliday').prop('checked', false);
            $('#Item_IsWeekend').prop('checked', false);
            $('#Item_Remarks').val('');

            $('#Item_LateMinutes').val(0);
            $('#Item_EarlyOutMinutes').val(0);
            $('#Item_WorkMinutes').val(0);
            $('#Item_OvertimeMinutes').val(0);
            $('#Item_IsManualEntry').val('true');

            $('#previewLate').text('0 min');
            $('#previewEarly').text('0 min');
            $('#previewWork').text('0h 0m');
            $('#previewOvertime').text('0h 0m');
        }

        // ------------------------------------------------------------
        // Save Attendance
        // ------------------------------------------------------------
        function saveAttendance() {
            const $form = $('#attendanceForm');
            if ($form.length === 0) {
                notify.error('Attendance form was not found.');
                return;
            }

            if ($.validator && !$form.valid()) {
                notify.warning('Please correct the validation errors before saving.');
                return;
            }

            calculateAttendance();

            const formElement = $form[0];
            const formData = new FormData(formElement);
            const $saveButton = $('#save-button');

            $.ajax({
                type: 'POST',
                url: '@Url.Action("Add", "Attendance")',
                data: formData,
                processData: false,
                contentType: false,
                beforeSend: function () {
                    $saveButton.prop('disabled', true).html(`
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        Saving...
                    `);
                },
                success: function (response) {
                    if (response.success) {
                        notify.success(response.message || 'Attendance saved successfully.');
                        $('#main-table').DataTable().ajax.reload(null, false);
                        closeModal();
                    } else {
                        notify.warning(response.message || 'Failed to save attendance.');
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 401 || xhr.status === 403) return;
                    notify.error('An error occurred while saving attendance.');
                },
                complete: function () {
                    $saveButton.prop('disabled', false).html(`
                        <i class="bi bi-check-circle me-1"></i>
                        Save Attendance
                    `);
                }
            });
        }

        // ------------------------------------------------------------
        // Edit & View Attendance
        // ------------------------------------------------------------
        function editAttendance(id) {
            $.ajax({
                type: 'GET',
                url: '@Url.Action("GetData", "Attendance")',
                data: { id: id },
                success: function (data) {
                    if (!data) {
                        notify.warning('Attendance record not found.');
                        return;
                    }

                    resetAttendanceForm();

                    $('#Item_AttendanceId').val(data.attendanceId);
                    $('#Item_AttendanceDate').val(data.attendanceDate);
                    $('#Item_AttendanceStatus').val(data.attendanceStatus || 'PRESENT');

                    loadShifts(data.shiftId);

                    $('#Item_ScheduledTimeIn').val(data.scheduledTimeIn ? data.scheduledTimeIn.substring(0, 5) : '');
                    $('#Item_ScheduledTimeOut').val(data.scheduledTimeOut ? data.scheduledTimeOut.substring(0, 5) : '');
                    $('#Item_ActualTimeIn').val(data.actualTimeIn ? data.actualTimeIn.substring(0, 5) : '');
                    $('#Item_ActualTimeOut').val(data.actualTimeOut ? data.actualTimeOut.substring(0, 5) : '');

                    $('#Item_IsHoliday').prop('checked', data.isHoliday === true);
                    $('#Item_IsWeekend').prop('checked', data.isWeekend === true);
                    $('#Item_Remarks').val(data.remarks || '');

                    if (data.employeeId) {
                        const empText = data.employee
                            ? `${data.employee.employeeCode} - ${data.employee.fullName}`
                            : (data.employeeName ? `${data.employeeCode ?? ''} - ${data.employeeName}` : data.employeeId);
                        const newOption = new Option(empText, data.employeeId, true, true);
                        $('#Item_EmployeeId').empty().append(newOption).trigger('change');
                    }

                    calculateAttendance();
                    showModal(true);
                },
                error: function (xhr) {
                    if (xhr.status === 401 || xhr.status === 403) return;
                    notify.error('Failed to retrieve attendance details.');
                }
            });
        }

        function viewAttendance(id) {
            editAttendance(id);
        }

        // ------------------------------------------------------------
        // Delete Attendance
        // ------------------------------------------------------------
        function deleteAttendance(id) {
            $.ajax({
                type: 'DELETE',
                url: '@Url.Action("Delete", "Attendance")',
                data: { id: id },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        $('#main-table').DataTable().ajax.reload(null, false);
                        notify.success(response.message || 'Attendance deleted successfully.');
                    } else {
                        notify.warning(response.message || 'Failed to delete attendance.');
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 401 || xhr.status === 403) return;
                    notify.error('Failed to delete attendance.');
                }
            });
        }
    </script>
}
