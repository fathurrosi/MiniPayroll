@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function closeModal() {
            const modalElement = document.getElementById('overtimeTypeModal');
            const modal = bootstrap.Modal.getInstance(modalElement);
            setReadonly(false);
            if (modal) {
                modal.hide();
            }
        }
        function showModal(isEdit) {
            $('#modalTitle').text(
                isEdit ? 'Edit Attendance' : 'Add Attendance'
            );

            setReadonly(isEdit);

            resetAttendanceForm();

            // Default date = today
            const today = new Date();

            const yyyy = today.getFullYear();
            const mm = String(today.getMonth() + 1).padStart(2, '0');
            const dd = String(today.getDate()).padStart(2, '0');

            $('#AttendanceDate').val(`${yyyy}-${mm}-${dd}`);

            loadShifts();

            const modal = new bootstrap.Modal(
                document.getElementById('attendanceModal')
            );
            modal.show();
        }
        $(document).ready(function () {
             $('#logoFile').on('change', function () {
                 const file = this.files[0];
                 const preview = document.getElementById('logoPreview');
                 if (!file) {
                     preview.style.display = 'none';
                     return;
                 }
                 preview.src = URL.createObjectURL(file);
                 preview.style.display = 'block';
            });
            
            const table = $('#main-table').DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                autoWidth: false,
                filter: true,
                orderMulti: false,
                order: [[1, "desc"]],
                ajax: {
                    url: '@Url.Action("GetList", "Attendance")',
                    type: "POST",
                    contentType: "application/json",
                    data: function (d) {
                        return JSON.stringify(d);
                    },
                    dataSrc: function (json) {
                        return json.data || [];
                    },
                    error: function (xhr) {
                        if (xhr.status === 401 || xhr.status === 403)
                            return;
                        notify.error("Failed to load attendance.");
                    }
                },
                columnDefs: [
                    {
                        targets: -1,
                        className: "not-export"
                    }
                ],
                columns: [
                    // Employee
                    {
                        //data: "employeeCode",
                        data : null,
                        title: "Employee",
                        width: "260px",
                        orderable: false,
                        render: function (data) {
                            return `
                                <div class="fw-bold">
                                    ${data.employeeCode}
                                </div>
                                <div>
                                    ${data.employeeName}
                                </div>
                                <small class="text-muted">
                                    ${data.DepartmentDescription ?? ""}
                                </small>
                            `;
                        }
                    },
                    // Attendance Date
                    {
                        data: "attendanceDate",
                        title: "Date",
                        width: "110px",
                        className: "text-center",
                        render: function (data) {
                            if (!data)
                                return "-";
                            return moment(data).format("DD MMM YYYY");
                        }
                    },
                    // Shift
                    {
                        data: "shiftCode",
                        title: "Shift",
                        width: "100px",
                        className: "text-center",
                        render: function (data) {
                            return `
                                <span class="badge bg-primary">
                                    ${data ?? "-"}
                                </span>
                            `;
                        }
                    },
                    // Schedule
                    {
                        data: null,
                        title: "Schedule",
                        width: "120px",
                         orderable: false,
                        className: "text-center",
                        render: function (data) {
                            return `
                                <div class="fw-semibold">
                                    ${data.scheduledTimeIn ?? "--:--"}
                                </div>

                                <small class="text-muted">
                                    ${data.scheduledTimeOut ?? "--:--"}
                                </small>
                            `;
                        }
                    },
                    // Actual
                    {
                        data: null,
                        title: "Actual",
                        width: "120px",
                         orderable: false,
                        className: "text-center",
                        render: function (data) {
                            return `
                                <div class="text-success fw-semibold">
                                    ${data.actualTimeIn ?? "-"}
                                </div>

                                <small class="text-danger">
                                    ${data.actualTimeOut ?? "-"}
                                </small>
                            `;
                        }
                    },
                    // Late / Early
                    {
                        data: null,
                        title: "Late/Early",
                        width: "120px",
                         orderable: false,
                        className: "text-center",
                        render: function (data) {
                            return `
                                <div>
                                    <span class="badge bg-danger">
                                        Late ${data.lateMinutes}m
                                    </span>
                                </div>
                                <div class="mt-1">
                                    <span class="badge bg-warning text-dark">
                                        Early ${data.earlyOutMinutes}m
                                    </span>
                                </div>
                            `;
                        }
                    },

                    // Working Hours
                    {
                        data: "workMinutes",
                        title: "Work",
                        width: "90px",
                        className: "text-center",
                        render: function (data) {
                            let h = Math.floor((data || 0) / 60);
                            let m = (data || 0) % 60;
                            return `
                                <span class="fw-bold">
                                    ${h}h ${m}m
                                </span>
                            `;
                        }
                    },

                    // OT
                    {
                        data: "overtimeMinutes",
                        title: "OT",
                        width: "90px",
                        className: "text-center",
                        render: function (data) {
                            if (!data)
                                return "-";

                            let h = Math.floor(data / 60);
                            let m = data % 60;
                            return `
                                <span class="badge bg-info">
                                    ${h}h ${m}m
                                </span>
                            `;
                        }
                    },
                    // Status
                    {
                        data: "attendanceStatus",
                        title: "Status",
                        width: "120px",
                        className: "text-center",
                        render: function (data) {
                            switch ((data || "").toUpperCase()) {
                                case "PRESENT":
                                    return `
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i>
                                            Present
                                        </span>`;
                                case "LATE":
                                    return `
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-clock"></i>
                                            Late
                                        </span>`;
                                case "ABSENT":
                                    return `
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle"></i>
                                            Absent
                                        </span>`;
                                case "LEAVE":
                                    return `
                                        <span class="badge bg-info">
                                            <i class="bi bi-airplane"></i>
                                            Leave
                                        </span>`;
                                case "HOLIDAY":
                                    return `
                                        <span class="badge bg-primary">
                                            <i class="bi bi-calendar-event"></i>
                                            Holiday
                                        </span>`;
                                case "RESTDAY":
                                    return `
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-moon"></i>
                                            Rest Day
                                        </span>`;
                                default:
                                    return `
                                        <span class="badge bg-dark">
                                            ${data}
                                        </span>`;
                            }
                        }
                    },

                    // Action
                    {
                        data: null,
                        title: "Action",
                        width: "90px",
                        className: "text-center",
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            return `
                                <div class="d-flex justify-content-center gap-2">
                                    <a href="javascript:void(0)"
                                       onclick="viewAttendance(${row.attendanceId})"
                                       title="View">
                                        <i class="fa-solid fa-eye text-primary"></i>
                                    </a>
                                    <a href="javascript:void(0)"
                                       onclick="editAttendance(${row.attendanceId})"
                                       title="Adjust">
                                        <i class="fa-solid fa-pen-to-square text-success"></i>
                                    </a>
                                </div>
                            `;
                        }
                    }
                ],
                dom:
                    "B<'row mb-3'<'col-md-6'l><'col-md-6 text-end'f>>" +
                    "rt" +
                    "<'row mt-3'<'col-md-6'i><'col-md-6'p>>",
                buttons: [
                    {
                        extend: "csvHtml5",
                        className: "btn-export-csv d-none",
                        title: "@Model.Title",
                        exportOptions: {
                            columns: ":not(.not-export)"
                        }
                    },
                    {
                        extend: "pdfHtml5",
                        className: "btn-export-pdf d-none",
                        title: "@Model.Title",
                        exportOptions: {
                            columns: ":not(.not-export)"
                        }
                    }

                ]

            });
            
            $('#csv-export').on('click', function () {
                $('.btn-export-csv').trigger('click');
            });

            $('#pdf-export').on('click', function () {
                $('.btn-export-pdf').trigger('click');
            });

            $('#add-new').on('click', function () {
                showModal(false);
            });
             $('#save-button').on('click', function () {
                saveovertimeType();
            });

            //$('#Item_IsActive').prop('checked', data.isActive === true);
        });

        function saveovertimeType() {
            const form = $('#overtimeTypeForm')[0];
            const formData = new FormData(form);
            $.ajax({
                type: 'POST',
                url: '@Url.Action("Add", "overtimeType")',
                data: formData,
                processData: false,
                contentType: false,
                beforeSend: function () {
                    $('#save-button').prop('disabled', true);
                },
                success: function (response) {
                    if (response.success) {
                        notify.success(response.message);
                        $('#main-table').DataTable().ajax.reload(null, false);
                        closeModal();
                    }
                    else {
                        notify.warning(response.message);
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 401 || xhr.status === 403)
                        return;
                    notify.error('An error occurred while saving Company overtimeType');
                },
                complete: function () {
                    $('#save-button').prop('disabled', false);
                }
            });
        }

        function editRow(code) {

            $.ajax({
                type: 'GET',
                url: '@Url.Action("GetData", "OvertimeType")',
                data: { code: code},

                success: function (data) {

                    if (!data) {
                        notify.warning('Overtime type not found.');
                        return;
                    }

                    // Basic Information
                    $('#Item_OvertimeCode').val(data.overtimeCode);
                    $('#Item_OvertimeName').val(data.overtimeName);
                    $('#Item_Description').val(data.description);

                    // Category
                    $('#Item_OvertimeCategory').val(data.overtimeCategory);

                    // Status
                    $('#Item_IsActive').prop('checked', data.isActive);

                    showModal(true);
                },

                error: function (xhr) {

                    if (xhr.status === 401 || xhr.status === 403)
                        return;

                    notify.error('Failed to retrieve overtime type.');

                }
            });

        }
        function deleteRow(code) {
            $.ajax({
                type: 'DELETE',
                url: '@Url.Action("Delete", "overtimeType")',
                data: {
                    code: code
                },
                headers: {
                    'RequestVerificationToken':
                        $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        $('#main-table').DataTable().ajax.reload(null, false);
                        resetForm();
                        notify.success(response.message);
                    } else {
                        notify.warning(response.message);
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 401 || xhr.status === 403)
                        return;
                    notify.error('Failed to delete Company overtimeType');
                }
            });
        }
        function resetForm() {
            $('#overtimeTypeForm')[0].reset();
        }

         
        function loadShifts() {
            $.ajax({
                type: 'GET',
                url: '@Url.Action("GetShifts", "Shift")',
                success: function (data) {
                    const select = $('#ShiftId');
                    select.empty();
                    select.append(
                        '<option value="">-- Select Shift --</option>'
                    );

                    if (!data)
                        return;

                    data.forEach(function (item) {
                        select.append(
                            $('<option>', {
                                value: item.id,
                                text: item.shiftCode + ' - ' +  item.shiftName
                            })
                        );

                    });
                },

                error: function (xhr) {
                    if (xhr.status === 401 || xhr.status === 403)
                        return;
                    notify.error('Failed to load shifts.');
                }
            });
        }
         
        $('#ShiftId').on('change', function () {
            const shiftId = $(this).val();
            if (!shiftId) {
                $('#ScheduledTimeIn').val('');
                $('#ScheduledTimeOut').val('');
                calculateAttendance();
                return;
            }

            $.ajax({
                type: 'GET',
                url: '@Url.Action("GetData", "Shift")',
                data: {
                    id: shiftId
                },
                success: function (data) {
                    if (!data)
                        return;

                    $('#ScheduledTimeIn').val(
                        data.startTime ?? ''
                    );
                    $('#ScheduledTimeOut').val(
                        data.endTime ?? ''
                    );
                    calculateAttendance();
                },

                error: function (xhr) {
                    if (xhr.status === 401 || xhr.status === 403)
                        return;
                    notify.error('Failed to retrieve shift.');
                }
            });
        });
         
        $('#ScheduledTimeIn, #ScheduledTimeOut, #ActualTimeIn, #ActualTimeOut')
            .on('change', function () {
                calculateAttendance();

            });


        function timeToMinutes(value) {
            if (!value)
                return null;

            const parts = value.split(':');
            if (parts.length < 2)
                return null;

            const hour = parseInt(parts[0], 10);
            const minute = parseInt(parts[1], 10);

            if (isNaN(hour) || isNaN(minute))
                return null;

            return (hour * 60) + minute;
        }


        function calculateAttendance() {
            const scheduledIn = timeToMinutes($('#ScheduledTimeIn').val());
            const scheduledOut = timeToMinutes($('#ScheduledTimeOut').val());
            const actualIn = timeToMinutes($('#ActualTimeIn').val());
            const actualOut = timeToMinutes($('#ActualTimeOut').val());
            let lateMinutes = 0;
            let earlyOutMinutes = 0;
            let workMinutes = 0;
            let overtimeMinutes = 0;
            // --------------------------------------------------------
            // Late
            // --------------------------------------------------------
            if (scheduledIn !== null &&
                actualIn !== null &&
                actualIn > scheduledIn) {
                lateMinutes = actualIn - scheduledIn;
            }


            // --------------------------------------------------------
            // Early Out
            // --------------------------------------------------------
            if (scheduledOut !== null &&
                actualOut !== null &&
                actualOut < scheduledOut) {
                earlyOutMinutes = scheduledOut - actualOut;
            }


            // --------------------------------------------------------
            // Working Minutes
            // --------------------------------------------------------

            if (actualIn !== null &&
                actualOut !== null) {
                let out = actualOut;
                // Support overnight shift
                if (out < actualIn) {
                    out += 24 * 60;
                }

                workMinutes = Math.max(
                    0,
                    out - actualIn
                );
            }


            // --------------------------------------------------------
            // Overtime
            // --------------------------------------------------------

            if (scheduledOut !== null &&
                actualOut !== null) {

                let out = actualOut;

                if (out < actualIn) {
                    out += 24 * 60;
                }

                let scheduled = scheduledOut;

                if (scheduled < scheduledIn) {
                    scheduled += 24 * 60;
                }

                overtimeMinutes = Math.max(
                    0,
                    out - scheduled
                );
            }


            // --------------------------------------------------------
            // Update hidden fields
            // --------------------------------------------------------

            $('#LateMinutes').val(lateMinutes);
            $('#EarlyOutMinutes').val(earlyOutMinutes);
            $('#WorkMinutes').val(workMinutes);
            $('#OvertimeMinutes').val(overtimeMinutes);
            // --------------------------------------------------------
            // Update preview
            // --------------------------------------------------------
            $('#previewLate').text(
                `${lateMinutes} min`
            );

            $('#previewEarly').text(
                `${earlyOutMinutes} min`
            );

            $('#previewWork').text(
                formatMinutes(workMinutes)
            );

            $('#previewOvertime').text(
                formatMinutes(overtimeMinutes)
            );
        }

        function formatMinutes(minutes) {
            minutes = parseInt(minutes || 0, 10);
            const hours = Math.floor(minutes / 60);
            const mins = minutes % 60;
            return `${hours}h ${mins}m`;
        }

        // ------------------------------------------------------------
        // Save Attendance
        // ------------------------------------------------------------

        $('#attendanceForm').on('submit', function (e) {
            e.preventDefault();
            const form = this;
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                return;
            }

            calculateAttendance();
            const formData = new FormData(form);
            const saveButton = $('#save-attendance');
            saveButton.prop('disabled', true);
            saveButton.html(`
                <span class="spinner-border spinner-border-sm me-1"></span>
                Saving...
            `);


            $.ajax({
                type: 'POST',
                url: '@Url.Action("Add", "Attendance")',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.success) {
                        notify.success(
                            response.message || 'Attendance saved successfully.'
                        );
                        attendanceModal.hide();
                        $('#main-table')
                            .DataTable()
                            .ajax.reload(null, false);

                    }
                    else {
                        notify.warning(
                            response.message ||
                            'Failed to save attendance.'
                        );
                    }
                },

                error: function (xhr) {
                    if (xhr.status === 401 || xhr.status === 403)
                        return;
                    notify.error(
                        'An error occurred while saving attendance.'
                    );
                },

                complete: function () {
                    saveButton.prop('disabled', false);
                    saveButton.html(`
                        <i class="bi bi-check-circle me-1"></i>
                        Save Attendance
                    `);
                }
            });

        });

