        // Reset form
        // ------------------------------------------------------------
        function resetAttendanceForm() {
            const form =$('#attendanceForm')[0];
            form.reset();
            form.classList.remove('was-validated');
            $('#EmployeeId').val('');
            $('#ShiftId').val('');
            $('#AttendanceStatus').val('PRESENT');
            $('#LateMinutes').val(0);
            $('#EarlyOutMinutes').val(0);
            $('#WorkMinutes').val(0);
            $('#OvertimeMinutes').val(0);
            $('#IsManualEntry').val('true');
            $('#previewLate').text('0 min');
            $('#previewEarly').text('0 min');
            $('#previewWork').text('0h 0m');
            $('#previewOvertime').text('0h 0m');
        }
         
