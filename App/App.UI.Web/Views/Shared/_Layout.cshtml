    <style type="text/css">
            /* ── Fix DataTables Horizontal Scrollbar (x-scroll) ──────── */
            /* Remove negative margins from Bootstrap .row inside DataTables wrapper */
            div.dataTables_wrapper > .row {
                margin-left: 0 !important;
                margin-right: 0 !important;
            }

            div.dataTables_wrapper > .row > [class*="col-"] {
                padding-left: 0 !important;
                padding-right: 0 !important;
            }

            /* Ensure DataTables and its table never exceed 100% container width */
            div.dataTables_wrapper {
                width: 100% !important;
            }

            table.dataTable {
                width: 100% !important;
                margin-left: 0 !important;
                margin-right: 0 !important;
            }

            /* Prevent table-responsive from showing spurious scrollbars */
            .table-responsive {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }

            /* ── DataTables Layout & Controls ────────────────────────── */
            /* length selector label */
            div.dataTables_length label {
                display: flex;
                align-items: center;
                gap: 0.4rem;
                font-size: 0.85rem;
                margin-bottom: 0;
                white-space: nowrap;
            }

            div.dataTables_length select {
                width: auto;
                display: inline-block;
                font-size: 0.85rem;
                padding: 0.2rem 0.5rem;
                height: auto;
            }
            /* search box */
            div.dataTables_filter label {
                display: flex;
                align-items: center;
                gap: 0.4rem;
                font-size: 0.85rem;
                margin-bottom: 0;
            }

            div.dataTables_filter input {
                font-size: 0.85rem;
                padding: 0.2rem 0.5rem;
                width: 200px;
                border: 1px solid #dee2e6;
                border-radius: 0.375rem;
            }

                div.dataTables_filter input:focus {
                    outline: none;
                    border-color: #86b7fe;
                    box-shadow: 0 0 0 0.2rem rgba(13,110,253,.15);
                }
            /* page info */
            div.dataTables_info {
                font-size: 0.82rem;
                color: #6c757d;
                padding-top: 0.4rem;
            }
            /* pagination */
            div.dataTables_paginate {
                padding-top: 0;
            }

                div.dataTables_paginate .pagination {
                    justify-content: flex-end;
                    margin-bottom: 0;
                    font-size: 0.82rem;
                }

                div.dataTables_paginate .page-link {
                    padding: 0.25rem 0.55rem;
                }

            /* ── Action Column Buttons ─────────────────────────────── */
            .action-col a {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 32px;
                height: 32px;
                border-radius: 6px;
                text-decoration: none;
                font-size: 1.05rem;
                transition: all 0.2s ease-in-out;
            }
            .action-col a:hover {
                background-color: rgba(0, 0, 0, 0.08);
                transform: scale(1.18);
            }
    </style>

